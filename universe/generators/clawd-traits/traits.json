{
  "$comment": "Clawd trait library. Every trait is a pixel pattern on the same unit grid as the body. Rows are strings; each character is a key into that trait's palette, '.' is empty. Anchors position the pattern against the body grid, so a hat always sits on his head no matter what else is on.",
  "grid": {
    "unit": 32,
    "canvas": [
      18,
      14
    ],
    "torso": {
      "x": 5,
      "y": 4,
      "w": 8,
      "h": 6
    },
    "stub": {
      "y": 6,
      "h": 2,
      "w": 2
    },
    "legs": {
      "y": 10,
      "h": 2,
      "w": 1,
      "torsoCols": [
        0,
        2,
        5,
        7
      ]
    },
    "eyes": {
      "row": 5,
      "torsoCols": [
        1,
        6
      ]
    },
    "eyePixel": 0.25,
    "itemPixel": 0.5,
    "$itemPixelComment": "Items (headwear, held) draw on a HALF-unit grid: twice the resolution of the body blocks, so a hat can have a brim and a pom without the body losing its chunky pixel identity."
  },
  "anchors": {
    "$comment": "Where a trait pattern's bottom-left corner lands, in canvas units. head = centered on the torso top edge; hand = just past the right stub; canvas = whole frame.",
